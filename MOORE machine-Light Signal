//Code1
module signal(clk, state);
  input clk;
  output reg [1:0] state;

  // State encoding
  parameter RED    = 2'b00;
  parameter GREEN  = 2'b01;
  parameter YELLOW = 2'b10;

  // Initial state   //For simulation
  initial begin
    state = RED;
  end

  always @(posedge clk) begin
    if (state == RED)
      state <= GREEN;
    else if (state == GREEN)
      state <= YELLOW;
    else
      state <= RED;
  end

endmodule

