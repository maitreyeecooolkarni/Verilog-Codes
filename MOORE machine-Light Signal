//Code1
module signal(clk, state);
  input clk;
  output reg [1:0] state;

  // State encoding
  parameter RED    = 2'b00;
  parameter GREEN  = 2'b01;
  parameter YELLOW = 2'b10;

  // Initial state   //For simulation
  initial begin
    state = RED;
  end

  always @(posedge clk) begin
    if (state == RED)
      state <= GREEN;
    else if (state == GREEN)
      state <= YELLOW;
    else
      state <= RED;
  end

endmodule

//Here output and state are considered to be the same
//Code 2
module signal(clk, state);
  input clk;
  output reg [1:0] state;

  parameter RED    = 2'b00;
  parameter GREEN  = 2'b01;
  parameter YELLOW = 2'b10;

  always @(posedge clk) begin
   if (rst)
      state <= RED;      //For RTL,a reset is always used
    if (state == RED)
      state <= GREEN;
    else if (state == GREEN)
      state <= YELLOW;
    else
      state <= RED;
  end

endmodule

